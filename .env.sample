DATABASE_URL="Database_URL"
DB_PORT=5435

JWT_SECRET=""
JWT_REFRESH_SECRET=""

# --- production uniquement ---
# Origines autorisées pour le CORS, séparées par des virgules (build web Expo).
# Vide / non défini = toutes les origines acceptées (dev).
CORS_ORIGINS=""
# 1 derrière un reverse proxy (Dokploy/Traefik) pour que le throttler voie la vraie IP.
# Laisser à 0 en local : sinon X-Forwarded-For est falsifiable.
TRUST_PROXY=0
