// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String         @id @default(uuid())
  username      String         @unique
  email         String         @unique
  password      String
  avatarSlug    String         @default("yellow-cyclops")
  role          Role           @default(USER)
  lang          String         @default("en")
  xp            Int            @default(0)
  refreshTokens RefreshToken[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  scores           Score[]
  sentRequests     Friendship[]  @relation("requester")
  receivedRequests Friendship[]  @relation("receiver")
  gamePlayers      GamePlayer[]
  soloSessions     SoloSession[]
}

model Question {
  id           String   @id @default(uuid())
  sourceId     String   @unique
  questionEn   String
  questionFr   String?
  answersEn    Json
  answersFr    Json?
  correctIndex Int
  category     String
  difficulty   String
  createdAt    DateTime @default(now())

  tags          Tag[]
  gameQuestions GameQuestion[]
  soloAnswers   SoloAnswer[]

  @@index([difficulty])
  @@index([category])
  @@index([category, difficulty])
}

// Sous-catégorie libre (ex. "football", "ligue-1") : usage interne, jamais affichée.
// Indépendante de Question.category — un même tag peut servir dans plusieurs catégories.
model Tag {
  id        String   @id @default(uuid())
  slug      String   @unique
  createdAt DateTime @default(now())

  questions Question[]
}

model Score {
  id         String     @id @default(uuid())
  value      Int        @default(0)
  difficulty Difficulty
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, difficulty])
  @@index([difficulty, value])
}

model Friendship {
  id         String           @id @default(uuid())
  status     FriendshipStatus @default(PENDING)
  // "<plus petit id>:<plus grand id>" — un seul lien par paire, quel que soit le sens
  // de la demande (A→B et B→A en même temps sont rejetés par Postgres)
  pairKey    String           @unique
  createdAt  DateTime         @default(now())
  acceptedAt DateTime?

  requesterId String
  requester   User   @relation("requester", fields: [requesterId], references: [id], onDelete: Cascade)

  receiverId String
  receiver   User   @relation("receiver", fields: [receiverId], references: [id], onDelete: Cascade)

  @@index([receiverId, status])
  @@index([requesterId, status])
}

model Game {
  id         String      @id @default(uuid())
  // Optionnel tant que « rejoindre par code » n'existe pas
  code       String?     @unique
  status     GameStatus  @default(WAITING)
  // null = mixte (toutes difficultés)
  difficulty Difficulty?
  createdAt  DateTime    @default(now())
  startedAt  DateTime?
  finishedAt DateTime?

  players       GamePlayer[]
  gameQuestions GameQuestion[]

  @@index([status])
}

model GamePlayer {
  id       String           @id @default(uuid())
  // Une invitation = un GamePlayer au statut INVITED
  status   GamePlayerStatus @default(INVITED)
  isHost   Boolean          @default(false)
  // Nombre de bonnes réponses
  score    Int              @default(0)
  xpEarned Int              @default(0)

  gameId String
  game   Game   @relation(fields: [gameId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  answers GameAnswer[]

  @@unique([gameId, userId])
  @@index([userId, status])
}

model GameQuestion {
  id    String @id @default(uuid())
  order Int

  gameId String
  game   Game   @relation(fields: [gameId], references: [id], onDelete: Cascade)

  questionId String
  question   Question @relation(fields: [questionId], references: [id])

  answers GameAnswer[]

  @@unique([gameId, order])
}

// Pas de ligne = pas de réponse dans le temps imparti
model GameAnswer {
  id          String  @id @default(uuid())
  answerIndex Int
  isCorrect   Boolean
  // Mesuré côté serveur, affiché seulement : n'entre jamais dans le score
  responseMs  Int

  gamePlayerId String
  gamePlayer   GamePlayer @relation(fields: [gamePlayerId], references: [id], onDelete: Cascade)

  gameQuestionId String
  gameQuestion   GameQuestion @relation(fields: [gameQuestionId], references: [id], onDelete: Cascade)

  @@unique([gamePlayerId, gameQuestionId])
}

model SoloSession {
  id         String            @id @default(uuid())
  status     SoloSessionStatus @default(IN_PROGRESS)
  difficulty Difficulty?
  category   String?
  lang       String            @default("en")
  expiresAt  DateTime
  createdAt  DateTime          @default(now())

  userId  String
  user    User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  answers SoloAnswer[]

  @@index([userId, status])
  @@index([status, expiresAt])
}

model SoloAnswer {
  id          String   @id @default(uuid())
  answerIndex Int
  isCorrect   Boolean
  createdAt   DateTime @default(now())

  sessionId   String
  soloSession SoloSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  questionId String
  question   Question @relation(fields: [questionId], references: [id])

  @@unique([sessionId, questionId])
}

enum FriendshipStatus {
  PENDING
  ACCEPTED
}

enum GameStatus {
  WAITING
  PLAYING
  FINISHED
  CANCELED
}

enum GamePlayerStatus {
  INVITED
  JOINED
  DECLINED
  LEFT
}

enum SoloSessionStatus {
  IN_PROGRESS
  FINISHED
  EXPIRED
  CANCELED
}

enum Role {
  USER
  ADMIN
}

enum Difficulty {
  easy
  medium
  hard
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
}
